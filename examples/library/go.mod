	github.com/pelletier/go-toml/v2 v2.0.8 // indirect
	github.com/redis/go-redis/v9 v9.18.0 // indirect
	github.com/spf13/cobra v1.7.0 // indirect
	github.com/spf13/pflag v1.0.5 // indirect
